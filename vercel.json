{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/scrape.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/coletor-shopee", "destination": "/public/coletor-shopee/index.html" },
    { "source": "/coletor-shopee/", "destination": "/public/coletor-shopee/index.html" },
    { "source": "/coletor-shopee/:path*", "destination": "/public/coletor-shopee/:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/coletor-shopee/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/coletor-shopee/" }
      ]
    }
  ]
}
