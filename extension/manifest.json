{
  "manifest_version": 3,
  "name": "Coletor Cata Preço+",
  "version": "1.3.0",
  "description": "Cataloga produtos e imagens de fornecedores em segundo plano no painel Cata Preço+.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Coletor Cata Preço+",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
